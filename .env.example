# Server Configuration
PORT=4000
JWT_SECRET=fashion_house_super_secret_jwt_key_2026

# AWS / DynamoDB Configuration
# Leave AWS keys empty if you are using AWS IAM Roles or Local DynamoDB with default credentials.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock_access_key
AWS_SECRET_ACCESS_KEY=mock_secret_key

# Set this to use a local DynamoDB instance (e.g., http://localhost:8000)
# DYNAMODB_ENDPOINT=http://localhost:8000

# DynamoDB Table Names
USERS_TABLE=EcommerceUsers
PRODUCTS_TABLE=EcommerceProducts
ORDERS_TABLE=EcommerceOrders

# Razorpay Configuration
# Replace these with your Razorpay Test/Live keys.
# If these are left blank, the app will run in "Bypass Mode" and simulate payment checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
